{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["cujarrett"],
  "reviewers": ["cujarrett"],
  "enabledManagers": ["argocd", "crossplane", "kubernetes","custom.regex"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/platform/api/composition\\.yaml/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/cujarrett/aws-spiffe-helper:(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[0-9a-f]+))?"
      ],
      "depNameTemplate": "ghcr.io/cujarrett/aws-spiffe-helper",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/cujarrett/aws-spiffe-helper"],
      "pinDigests": true,
      "minimumReleaseAge": "0 days"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/cluster/argocd/.+\\.yaml$/",
      "/cluster/monitoring/.+\\.yaml$/"
    ]
  },
  "crossplane": {
    "managerFilePatterns": [
      "/cluster/crossplane/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/cluster/.+/.+\\.yaml$/"
    ]
  }
}
