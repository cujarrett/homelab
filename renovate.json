{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["cujarrett"],
  "reviewers": ["cujarrett"],
  "enabledManagers": ["argocd", "crossplane", "kubernetes","custom.regex"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/platform/api/composition\\.yaml/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/cujarrett/aws-spiffe-helper:(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[0-9a-f]+))?"
      ],
      "depNameTemplate": "ghcr.io/cujarrett/aws-spiffe-helper",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/cujarrett/aws-spiffe-helper"],
      "pinDigests": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "matchPackageNames": ["cilium"],
      "minimumReleaseAge": "30 days",
      "prBodyNotes": [
        "⚠️ **Before merging:** run `/cilium-pre-merge-check` — any Cilium agent restart can trigger a world-identity regression that breaks kubelet host-to-pod probes, regardless of version. See `docs/cilium-world-identity-bug.md`."
      ]
    },
    {
      "matchPackageNames": ["adguard/adguardhome"],
      "prBodyNotes": [
        "⚠️ **Before merging:** run `/adguard-pre-pull` — AdGuard's `Recreate` rollout strategy plus `ctrl-1`'s DNS pointing only at AdGuard itself means a cold image pull will fail with `ImagePullBackOff`."
      ]
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/cluster/argocd/.+\\.yaml$/",
      "/cluster/monitoring/.+\\.yaml$/"
    ]
  },
  "crossplane": {
    "managerFilePatterns": [
      "/cluster/crossplane/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/cluster/.+/.+\\.yaml$/"
    ]
  }
}
