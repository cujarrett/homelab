{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["cujarrett"],
  "reviewers": ["cujarrett"],
  "enabledManagers": ["argocd", "crossplane", "kubernetes", "regex"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["platform/api/composition\\.yaml"],
      "matchStrings": [
        "image: ghcr\\.io/cujarrett/aws-spiffe-helper:(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[0-9a-f]+))?"
      ],
      "depNameTemplate": "ghcr.io/cujarrett/aws-spiffe-helper",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/cujarrett/aws-spiffe-helper"],
      "pinDigests": true,
      "minimumReleaseAge": "0 days"
    }
  ],
  "argocd": {
    "fileMatch": [
      "cluster/argocd/.+\\.yaml$",
      "cluster/monitoring/.+\\.yaml$"
    ]
  },
  "crossplane": {
    "fileMatch": ["cluster/crossplane/.+\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["cluster/.+/.+\\.yaml$"]
  }
}
